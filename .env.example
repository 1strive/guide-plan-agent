# 若本机 3000 已被占用（如其他服务），可改为 3001
PORT=3001
PG_HOST=127.0.0.1
# 使用仓库内 docker-compose 时映射为 5433，避免与主机已有 PostgreSQL(5432) 冲突
PG_PORT=5433
PG_USER=root
PG_PASSWORD=test
PG_DATABASE=guide_plan

OPENAI_BASE_URL=https://api.minimaxi.com/v1
OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=gpt-4o-mini

CHAT_HISTORY_LIMIT=30
LLM_MAX_TOOL_ROUNDS=10

# LLM 推理参数 (0.0~2.0, 值越高输出越随机)
LLM_TEMPERATURE=0.4
# 单次响应 token 上限,关联成本与截断风险
LLM_MAX_TOKENS=2048
# 核采样,通常与 temperature 二选一调
LLM_TOP_P=1
# fetch 总超时(毫秒),八股 08 §1 外部调用必须设超时
LLM_REQUEST_TIMEOUT_MS=60000

# 模型计价(美元 / 1K tokens),配合 Task 1.2 输出 cost_usd 日志
# 默认 0 表示不计算成本;请按所用模型的实际定价填入
MODEL_PRICE_INPUT_PER_1K=0
MODEL_PRICE_OUTPUT_PER_1K=0

# ── Task 4.4:MCP 工具 ──────────────────────────────────────────
# 总开关(默认 true;关闭后 Agent 无任何工具可用)
MCP_ENABLED=true

# 高德地图 MCP — POI 搜索、天气、路线规划
# 获取:https://lbs.amap.com 控制台 → 应用 → 创建 → Web 服务 Key
# 不配则不启动高德 server(fetch 仍可用)
# MCP_AMAP_API_KEY=

# 文件系统 MCP — 允许 Agent 读写的本地目录(逗号分隔)
# 安全考虑:不配则不启动 filesystem server
# MCP_FILESYSTEM_ALLOWED_DIRS=./docs

# 记忆分层:对话消息数达到此阈值后触发摘要(Task 4.3)
MEMORY_SUMMARY_THRESHOLD=20

# ── Task 5.4:Redis 热层 ────────────────────────────────────────
# agent_run_events 高频写入与跨进程广播迁到 Redis;docker-compose 映射 6380
REDIS_URL=redis://127.0.0.1:6380
# Run finalize 归档完成后 Redis Stream 保留时长(秒),给续订留缓冲
REDIS_EVENT_TTL_SEC=3600
