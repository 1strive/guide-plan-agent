# 若本机 3000 已被占用（如其他服务），可改为 3001
PORT=3001
MYSQL_HOST=127.0.0.1
# 使用仓库内 docker-compose 时映射为 3307，避免与主机已有 MySQL(3306) 冲突
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=test
MYSQL_DATABASE=guide_plan

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=gpt-4o-mini

CHAT_HISTORY_LIMIT=30
LLM_MAX_TOOL_ROUNDS=10

# LLM 推理参数 (0.0~2.0, 值越高输出越随机)
LLM_TEMPERATURE=0.4
# 单次响应 token 上限,关联成本与截断风险
LLM_MAX_TOKENS=2048
# 核采样,通常与 temperature 二选一调
LLM_TOP_P=1
# fetch 总超时(毫秒),八股 08 §1 外部调用必须设超时
LLM_REQUEST_TIMEOUT_MS=60000

# 模型计价(美元 / 1K tokens),配合 Task 1.2 输出 cost_usd 日志
# 默认 0 表示不计算成本;请按所用模型的实际定价填入
MODEL_PRICE_INPUT_PER_1K=0
MODEL_PRICE_OUTPUT_PER_1K=0

# Task 3.7:Tavily 联网搜索(无 key 时 web_search 工具自动降级)
# TAVILY_API_KEY=
# WEB_SEARCH_CACHE_TTL_SECONDS=86400
