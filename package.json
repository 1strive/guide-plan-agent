{
  "name": "guide-plan-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "setup": "docker compose up -d && tsx scripts/migrate.ts && tsx scripts/seed.ts",
    "web:dev": "cd web && npm run dev",
    "eval": "tsx scripts/eval-prompt.ts",
    "eval:base": "tsx scripts/eval-prompt.ts --version v1_base",
    "eval:cot": "tsx scripts/eval-prompt.ts --version v2_cot",
    "eval:smoke": "tsx scripts/eval-prompt.ts --version v1_base --case ask-01 --sleep 100",
    "eval:safe": "tsx scripts/eval-prompt.ts --version v1_base --case inj-01,inj-02,inj-03,inj-04,inj-05"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@langchain/core": "^1.1.48",
    "@langchain/langgraph": "^1.3.2",
    "@langchain/openai": "^1.4.7",
    "@tavily/core": "^0.7.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.2.0",
    "langchain": "^1.4.2",
    "mysql2": "^3.11.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "concurrently": "^9.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "repository": "git@github.com:1strive/guide-plan-agent.git"
}
